---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import "@fontsource-variable/manrope/wght.css";
import "@fontsource-variable/space-grotesk/wght.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/600.css";
import "@/styles/global.css";

export interface Props {
  description?: string;
  image?: string;
  title?: string;
}

const {
  description = "Corphy's field notes on research, software, and systems work.",
  image,
  title,
} = Astro.props;

const site = Astro.site ?? new URL("https://corphysha.github.io");
const base = import.meta.env.BASE_URL;
const pageTitle = title ? `${title} | Corphy` : "Corphy | Field notes & systems work";
const canonicalUrl = new URL(Astro.url.pathname, site).toString();
const imageUrl = image
  ? new URL(image, site).toString()
  : new URL(`${base}og-image.svg`, site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0D1117" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader pathname={Astro.url.pathname} />
    <slot />
    <SiteFooter />
  </body>
</html>
