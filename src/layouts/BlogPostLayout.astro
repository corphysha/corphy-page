---
import CodeCopyButton from "@/components/CodeCopyButton.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import Layout from "@/layouts/Layout.astro";
import type { BlogPost } from "@/lib/blog";
import { formatPostDate, toTagSlug } from "@/lib/blog";
import "@/styles/blog.css";

export interface Props {
  date: Date;
  description: string;
  headings: Array<{ depth: number; slug: string; text: string }>;
  image?: string;
  newer?: BlogPost;
  older?: BlogPost;
  readingTime: number;
  tags: string[];
  title: string;
}

const { date, description, headings, image, newer, older, readingTime, tags, title } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<Layout title={title} description={description} {...(image ? { image } : {})}>
  <main id="main-content" class="article-shell">
    <article>
      <header class="article-header">
        <a class="article-back" href={`${base}blog/`}>Back to field notes</a>
        <h1>{title}</h1>
        <p class="article-description">{description}</p>
        <div class="article-meta">
          <time datetime={date.toISOString()}>{formatPostDate(date)}</time>
          <span>{readingTime} min read</span>
        </div>
      </header>

      <div class="article-layout">
        <aside class="article-context">
          <p class="article-context-title">Filed under</p>
          {
            tags.length > 0 ? (
              <ul class="tag-list">
                {tags.map((tag) => (
                  <li>
                    <a href={`${base}blog/tags/${toTagSlug(tag)}/`}>#{tag}</a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="table-of-contents-empty">No topic has been assigned.</p>
            )
          }
        </aside>

        <div class="article-reading">
          <div class="article-content">
            <slot />
          </div>

          {
            (newer || older) && (
              <nav class="article-navigation" aria-label="Adjacent field notes">
                {newer ? (
                  <a href={`${base}blog/${newer.id}/`}>
                    <span class="article-navigation-label">Newer note</span>
                    <span class="article-navigation-title">{newer.data.title}</span>
                  </a>
                ) : (
                  <span aria-hidden="true"></span>
                )}
                {older ? (
                  <a href={`${base}blog/${older.id}/`}>
                    <span class="article-navigation-label">Older note</span>
                    <span class="article-navigation-title">{older.data.title}</span>
                  </a>
                ) : (
                  <span aria-hidden="true"></span>
                )}
              </nav>
            )
          }
        </div>

        <TableOfContents headings={headings} />
      </div>
    </article>
  </main>
  <CodeCopyButton />
</Layout>
