---
import { getCollection } from "astro:content";
import ArticleList from "@/components/ArticleList.astro";
import Layout from "@/layouts/Layout.astro";
import { sortPostsNewestFirst } from "@/lib/blog";
import "@/styles/blog.css";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  );
  const tags = new Set<string>();

  for (const post of posts) {
    for (const tag of post.data.tags) {
      tags.add(tag.toLocaleLowerCase());
    }
  }

  return [...tags].map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const allPosts = await getCollection("blog", ({ data }) =>
  import.meta.env.PROD ? !data.draft : true,
);
const posts = sortPostsNewestFirst(
  allPosts.filter((post) => post.data.tags.some((postTag) => postTag.toLocaleLowerCase() === tag)),
);
const base = import.meta.env.BASE_URL;
---

<Layout title={`Topic: ${tag}`} description={`Field notes tagged ${tag}.`}>
  <main id="main-content" class="blog-index">
    <header class="blog-index-heading">
      <a class="article-back" href={`${base}blog/`}>Back to field notes</a>
      <h1>#{tag}</h1>
      <p>
        {posts.length} {posts.length === 1 ? "field note" : "field notes"} filed under this topic.
      </p>
    </header>

    <section aria-label={`Field notes tagged ${tag}`}>
      {
        posts.length > 0 ? (
          <ArticleList posts={posts} />
        ) : (
          <p class="blog-empty">No field notes are filed under this topic.</p>
        )
      }
    </section>
  </main>
</Layout>
