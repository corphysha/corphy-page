---
import { getCollection, render } from "astro:content";
import BlogPostLayout from "@/layouts/BlogPostLayout.astro";
import { getAdjacentPosts, getReadingTime, sortPostsNewestFirst } from "@/lib/blog";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  );

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const allPosts = await getCollection("blog", ({ data }) =>
  import.meta.env.PROD ? !data.draft : true,
);
const { newer, older } = getAdjacentPosts(sortPostsNewestFirst(allPosts), post.id);
---

<BlogPostLayout
  date={post.data.date}
  description={post.data.description}
  headings={headings}
  {...(post.data.image ? { image: post.data.image } : {})}
  {...(newer ? { newer } : {})}
  {...(older ? { older } : {})}
  readingTime={getReadingTime(post)}
  tags={post.data.tags}
  title={post.data.title}
>
  <Content />
</BlogPostLayout>
