---
import { getCollection } from "astro:content";
import ArticleList from "@/components/ArticleList.astro";
import Layout from "@/layouts/Layout.astro";
import { getAllTags, sortPostsNewestFirst, toTagSlug } from "@/lib/blog";
import "@/styles/blog.css";

const allPosts = await getCollection("blog", ({ data }) =>
  import.meta.env.PROD ? !data.draft : true,
);
const posts = sortPostsNewestFirst(allPosts);
const tags = getAllTags(posts);
const base = import.meta.env.BASE_URL;
---

<Layout
  title="Field notes"
  description="Technical field notes on research, systems work, browser technology, and shipping reliable software."
>
  <main id="main-content" class="blog-index">
    <header class="blog-index-heading">
      <h1>Field notes</h1>
      <p>
        Technical notes from the workbench: research, implementation details, browser experiments,
        and the practices that make systems last.
      </p>
    </header>

    <div class="blog-index-layout">
      <section aria-label="Published field notes">
        {
          posts.length > 0 ? (
            <ArticleList posts={posts} />
          ) : (
            <p class="blog-empty">No field notes are published yet.</p>
          )
        }
      </section>

      <aside class="topic-rail">
        <h2>Browse by topic</h2>
        {
          tags.length > 0 ? (
            <ul>
              {tags.map((tag) => (
                <li>
                  <a href={`${base}blog/tags/${toTagSlug(tag.name)}/`}>
                    #{tag.name} <span class="topic-count">({tag.count})</span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="table-of-contents-empty">Topics appear with published notes.</p>
          )
        }
      </aside>
    </div>
  </main>
</Layout>
