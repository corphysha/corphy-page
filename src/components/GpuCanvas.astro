---
/**
 * Live WebGPU canvas powered by vgpu — a domain-warped FBM nebula with
 * interactive pointer distortion, electric filaments, and a starfield.
 * Falls back gracefully when WebGPU is unavailable.
 */
const fallback =
  "Your browser doesn't support WebGPU — but the code above is exactly what your GPU would be running.";
---

<canvas
  id="vgpu-demo"
  class="vgpu-canvas"
  width="960"
  height="540"
  aria-label="Live WebGPU shader: interactive nebula — move your pointer over it"
>
</canvas>
<p class="vgpu-fallback" data-vgpu-fallback hidden>{fallback}</p>

<style>
  .vgpu-canvas {
    display: block;
    width: 100%;
    max-width: 860px;
    height: auto;
    aspect-ratio: 16 / 9;
    margin: 1.5rem 0;
    border-radius: var(--radius-lg, 16px);
    border: 1px solid color-mix(in srgb, var(--accent, #f2632a) 35%, transparent);
    background: #04102a;
    box-shadow: 0 8px 32px rgb(0 0 0 / 0.35);
    cursor: crosshair;
  }

  .vgpu-fallback {
    margin: -0.75rem 0 1.5rem;
    font-size: 0.875rem;
    color: var(--text-muted, #94a3b8);
    font-style: italic;
  }
</style>

<script>
  import { clock, init, effect, frameLoop, surface } from "vgpu";

  const WGSL = /* wgsl */ `
  struct Params { time: f32, texel: vec2f, mouse: vec2f }
  @group(0) @binding(0) var<uniform> params: Params;

  fn hash21(p: vec2f) -> f32 {
    var q = fract(p * vec2f(123.34, 456.21));
    q = q + dot(q, q + 45.32);
    return fract(q.x * q.y);
  }

  fn vnoise(p: vec2f) -> f32 {
    let i = floor(p);
    let f = fract(p);
    let u = f * f * (3.0 - 2.0 * f);
    let a = hash21(i);
    let b = hash21(i + vec2f(1.0, 0.0));
    let c = hash21(i + vec2f(0.0, 1.0));
    let d = hash21(i + vec2f(1.0, 1.0));
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
  }

  fn fbm(p0: vec2f) -> f32 {
    let rot = mat2x2f(0.80, 0.60, -0.60, 0.80);
    var v = 0.0;
    var amp = 0.55;
    var p = p0;
    for (var i = 0; i < 5; i++) {
      v += amp * vnoise(p);
      p = rot * p * 2.02 + vec2f(11.3, 7.1);
      amp *= 0.5;
    }
    return v;
  }

  @fragment
  fn fs_main(@location(0) fragUV: vec2f) -> @location(0) vec4f {
    let t = params.time;
    let res = vec2f(1.0) / params.texel;

    var p = fragUV * 2.0 - 1.0;
    p.x *= res.x / res.y;

    // --- pointer gravity: space bends toward the cursor ---
    let m = (params.mouse * 2.0 - 1.0) * vec2f(res.x / res.y, 1.0);
    let toM = p - m;
    let md = length(toM);
    p += (toM / max(md, 0.001)) * 0.35 * exp(-md * 2.0) * sin(t * 0.9);

    // --- slow rotation drift ---
    let ang = t * 0.05 + 0.3 * sin(t * 0.11);
    let ca = cos(ang);
    let sa = sin(ang);
    p = mat2x2f(ca, -sa, sa, ca) * p;

    // --- double domain warp (iq-style) ---
    let pp = p * 1.4;
    let tt = t * 0.10;
    let q = vec2f(
      fbm(pp + vec2f(0.0, tt)),
      fbm(pp + vec2f(5.2, 1.3) - tt)
    );
    let r = vec2f(
      fbm(pp + 2.6 * q + vec2f(1.7, 9.2) + 0.18 * tt),
      fbm(pp + 2.6 * q + vec2f(8.3, 2.8) - 0.12 * tt)
    );
    let f = fbm(pp + 2.6 * r);

    // --- palette: abyss -> ocean -> corphish ember ---
    let deep  = vec3f(0.016, 0.031, 0.090);
    let ocean = vec3f(0.055, 0.180, 0.330);
    let ember = vec3f(0.949, 0.388, 0.165);
    let gold  = vec3f(1.000, 0.780, 0.340);

    var col = mix(deep, ocean, smoothstep(0.15, 0.75, f));
    let glow = smoothstep(0.42, 0.95, length(r));
    col = mix(col, ember, glow * smoothstep(0.35, 0.80, f));
    col += gold * pow(clamp(f * 1.2 - 0.35, 0.0, 1.0), 3.0) * 0.6;

    // --- electric filaments where warp channels cross ---
    let fil = pow(
      smoothstep(0.46, 0.50, abs(r.x - r.y)) * smoothstep(0.40, 0.90, f),
      2.0
    );
    col += ember * fil * 1.4;

    // --- starfield, only visible through dark regions ---
    let sp = fragUV * res / 3.0;
    let sid = floor(sp);
    let sf = fract(sp) - 0.5;
    let s = hash21(sid);
    if (s > 0.92) {
      let tw = 0.5 + 0.5 * sin(t * (1.0 + s * 3.0) + s * 40.0);
      let star = smoothstep(0.25, 0.0, length(sf)) * tw
               * (1.0 - smoothstep(0.2, 0.6, f));
      col += vec3f(star);
    }

    // --- vignette ---
    col *= 1.0 - 0.35 * dot(p * 0.7, p * 0.7);

    return vec4f(col, 1.0);
  }`;

  function setup(): void {
    const canvas = document.getElementById("vgpu-demo") as HTMLCanvasElement | null;
    const fallbackEl = document.querySelector<HTMLElement>("[data-vgpu-fallback]");
    if (!canvas) return;

    const supported =
      typeof navigator !== "undefined" && "gpu" in navigator && navigator.gpu !== null;

    if (!supported) {
      canvas.hidden = true;
      fallbackEl?.removeAttribute("hidden");
      return;
    }

    boot(canvas).catch(() => {
      canvas.hidden = true;
      fallbackEl?.removeAttribute("hidden");
    });
  }

  async function boot(canvas: HTMLCanvasElement): Promise<void> {
    const gpu = await init();
    const canvasSurface = surface(gpu, canvas, { dpr: [1, 2] });

    const mouse = { x: 0.5, y: 0.5 };
    const plasma = effect(gpu, WGSL, {
      set: {
        params: { time: 0, texel: canvasSurface.texelSize, mouse: [0.5, 0.5] },
      },
    });

    canvas.addEventListener("pointermove", (e) => {
      const rect = canvas.getBoundingClientRect();
      mouse.x = (e.clientX - rect.left) / rect.width;
      mouse.y = 1.0 - (e.clientY - rect.top) / rect.height;
    });

    canvasSurface.onResize(() => {
      plasma.set({ params: { texel: canvasSurface.texelSize } });
    });

    const time = clock(gpu);
    frameLoop(gpu, (frame) => {
      plasma.set({
        params: { time: time.time, mouse: [mouse.x, mouse.y] },
      });
      frame.pass(canvasSurface, plasma);
    });
  }

  // Run on initial load and after Astro View Transitions swap.
  document.addEventListener("DOMContentLoaded", setup);
  document.addEventListener("astro:after-swap", setup);
</script>
