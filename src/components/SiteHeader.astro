---
export interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
const base = import.meta.env.BASE_URL;
const homePath = base;
const blogPath = `${base}blog/`;
const rssPath = `${base}rss.xml`;

const links = [
  {
    href: homePath,
    label: "Home",
    active: pathname === homePath || pathname === base.slice(0, -1),
  },
  { href: blogPath, label: "Field notes", active: pathname.startsWith(blogPath) },
  { href: rssPath, label: "RSS", active: false },
  { href: "https://github.com/corphysha", label: "GitHub", active: false, external: true },
];
---

<header class="site-header">
  <div class="site-header-inner">
    <a class="site-brand" href={homePath} aria-label="Corphy home">
      <span aria-hidden="true" class="site-brand-mark">C</span>
      <span>Corphy</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={link.active ? "page" : undefined}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noreferrer" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
